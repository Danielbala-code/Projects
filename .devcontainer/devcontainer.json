{
  "name": "Procedure-to-Skill Studio",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": {"cpus": 2, "memory": "4gb", "storage": "8gb"},
  "postCreateCommand": "bash scripts/setup.sh",
  "forwardPorts": [8000],
  "portsAttributes": {"8000": {"label": "Procedure-to-Skill Studio", "onAutoForward": "notify"}},
  "customizations": {"vscode": {"settings": {"python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"}}}
}
